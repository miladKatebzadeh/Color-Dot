pipeline {
    agent any

    environment{
        VENV=".venv"
    }
    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                
                python3 -m venv $VENV
                . $VENV/bin/activate
                pip install -r requirements.txt
                pip install pytest
                '''
            }
        }

        stage('Run Project') {
                steps {
                        sh '''
                        guinite  --bind 0.0.0.0:5000 main:app
                        '''
                    }
                }



        // stage('Run Tests') {
        //     steps {
        //         sh '''
        //         . $VENV/bin/activate
        //         pytest test/ --junitxml=results.xml
        //         '''
        //     }
        // }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}