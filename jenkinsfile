pipeline {
    agent any

    environment{
        VENV=".venv"
    }
    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                
                python3 -m venv $VENV
                . $VENV/bin/activate
                pip install -r requirements.txt
                pip install pytest
                pip install gunicorn
                pip list
                '''
            }
        }

        // stage('Run Tests') {
        //     steps {
        //         sh '''
        //         . $VENV/bin/activate
        //         pytest
        //         '''
        //     }
        // }

        stage('Debug User') {
            steps {
                sh '''
                whoami
                id
                ls -l /var/run/docker.sock
                docker version
                '''
                }
        }
        stage('Build Docker Image') {
            steps {
                sh '''
                docker build --no-cache -t  color-dot:${BUILD_NUMBER} .
                '''
            }

        }
        stage('deploy Application') {
            steps {
                sh '''
                docker rm -f color-dot || true

                docker run -d --network devops --name color-dot -p 5001:5000 color-dot:${BUILD_NUMBER}
                '''
            }
        }

        stage('Health Check') { 
            steps {
                sh '''
                sleep 5
                curl --fail http://color-dot:5000

                '''
            }
        }




        // stage('Run Project') {
        //         steps {
        //                 sh '''
        //                 . $VENV/bin/activate
        //                 gunicorn  --bind 0.0.0.0:5000 app:app
        //                 '''
        //             }
        //         }



    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}