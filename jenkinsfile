pipeline {
    agent any 

    stages{

        stage('Checkout'){
            steps {
            echo(message: 'Cheking Out Source Code')
            }
            checkout scm 
        }

        stage('Install Dependencies'){
            steps {
                echo(message: 'Installing Python')
                sh 'pip install -r requirements.txt'
            }
        }
        
        stage('Run Tests'){
            steps {
                echo(message: 'Running Tests ....')
                sh 'pytest'
            }
        }
        
    }    
    post{
            success{
                echo(message: 'Pipline Completed Successfully')
            }
            failure{
                echo(message: 'Pipline Failed')
            }
        }

}